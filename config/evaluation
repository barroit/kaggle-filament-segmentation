menu "YOLO Evaluation"

config YOLO_PRED_BATCH
	int "Prediction batch size"
	default 32
	help
	  Number of images processed in each prediction batch.

config YOLO_CONF_THRESHOLD
	int "Prediction confidence threshold"
	range 0 100
	default 35
	help
	  Predictions with confidence below this percentage are discarded.

config YOLO_MATCH_THRESHOLD
	int "Mask matching threshold"
	range 0 100
	default 50
	help
	  Predicted masks are considered matched when their IoU with a
	  ground-truth mask reaches this percentage.

config YOLO_CROP_RECALL_THRESHOLD
	int "Crop recall threshold"
	range 0 100
	default 95
	help
	  Minimum percentage of a ground-truth filament covered by a
	  true-positive crop to contribute to crop recall.

config YOLO_SPINE_BINS
	int "Number of spine length bins"
	default 5
	help
	  Number of quantile bins used to group filaments by spine length.

config YOLO_PERIOD_WARN_THRESHOLD
	int "Period recall warning threshold"
	range 0 100
	default 50
	help
	  Observation periods with recall below this percentage are annotated
	  on the recall plot.

endmenu # YOLO Evaluation
