menu "Data Preprocessing"

config DROP_SUN_LIMB
	bool "Drop solar limb"
	default n
	help
	  Enable this to erase the solar limb from input images

config DROP_CORRUPTED_ANNO
	bool "Drop corrupted annotations"
	default y
	help
	  Enable this to drop corrupted annotations.

menuconfig DROP_CONFLICTED_ANNO
	bool "Drop conflicting annotations"
	default y
	help
	  Enable this to drop conflicting annotations from different annotators.

if DROP_CONFLICTED_ANNO

config ANNO_CONFLICT_THRESHOLD
	int "Annotation conflicting threshold"
	range 0 100
	default 55
	help
	  Annotations are considered conflicting when one covers more than this
	  percentage of another.

config ANNO_CONFLICT_WINNER_RATIO
	int "Annotation conflicting winner ratio"
	range 0 100
	default 100
	help
	  When annotations conflict, retain the annotation whose length ratio to
	  the longest annotation is closest to this value.

endif # menuconfig DROP_CONFLICTED_ANNO

menuconfig DROP_OVERLAPPED_ANNO
	bool "Drop overlapping annotations"
	default y
	help
	  Enable this to drop annotations with overlapping polygons.

if DROP_OVERLAPPED_ANNO

config ANNO_OVERLAP_THRESHOLD
	int "Annotation overlapping threshold"
	range 0 100
	default 5
	help
	  Annotations are considered overlapping when their polygon IoU exceeds
	  this threshold.

endif # menuconfig DROP_OVERLAPPED_ANNO

menu "Dataset Splitting"

config OBSERVE_PERIOD
	int "Observation period duration"
	default 7
	help
	  Number of calendar days in each observation period.

config SPLIT_TEMPORAL_GAP
	int "Minimum cross-dataset temporal gap"
	default 3
	help
	  Minimum number of excluded calendar days at boundaries between
	  observation periods assigned to different dataset splits.

config SPLIT_PRNG_SEED
	int "Dataset splitting PRNG seed"
	default 39
	help
	  Seed for reproducible random assignment of observation periods to
	  dataset splits.

config TRAIN_SET_PROPORTION
	int "Training set proportion"
	range 0 100
	default 56
	help
	  Target proportion of annotations assigned to the training set.

config VALIDATE_SET_PROPORTION
	int "Validation set proportion"
	range 0 100
	default 14
	help
	  Target proportion of annotations assigned to the validation set.

config TEST_SET_PROPORTION
	int "Test set proportion"
	range 0 100
	default 30
	help
	  Target proportion of annotations assigned to the test set.

endmenu # Dataset Splitting

endmenu # Data Preprocessing
