menu "Data preprocessing"

config DROP_SUN_LIMB
	bool "Erase the solar limb from input images"
	default y

menuconfig FILTER_ANNO
	bool "Drop conflicting annotations across annotators"
	default y

if FILTER_ANNO
	config CONFLICT_IOU_THRESHOLD
		int "Minimum inter-annotator IoU for conflict in percent"
		range 0 100
		default 28

	config CONFLICT_WINNER_LENGTH_RATIO
		int "Target winner-to-longest filament length ratio in percent"
		range 0 100
		default 100
endif # menuconfig FILTER_ANNO

config DROP_DUPLICATED_ANNO
	bool "Drop annotations with identical spines"
	default y

config DROP_OVERLAPPED_ANNO
	bool "Drop annotations with overlapping polygons"
	default y

menuconfig USE_FOLD
	bool "Enable K-fold dataset partitioning"
	default y

if USE_FOLD

config NR_FOLDS
	int "Number of folds (K)"
	default 5

config FOLD_PRNG_SEED
	int "PRNG seed for fold shuffling"
	default 39

choice
	prompt "Temporal grouping granularity"
	default OBSERVE_TEMPORAL_UNIT_DATE

config OBSERVE_TEMPORAL_UNIT_DATE
	bool "By date (YYYYMMDD)"

config OBSERVE_TEMPORAL_UNIT_HOUR
	bool "By hour (YYYYMMDDHH)"

config OBSERVE_TEMPORAL_UNIT_MINUTE
	bool "By minute (YYYYMMDDHHMM)"

endchoice

config OBSERVE_TEMPORAL_UNIT
	int
	default 8 if OBSERVE_TEMPORAL_UNIT_DATE
	default 10 if OBSERVE_TEMPORAL_UNIT_HOUR
	default 12 if OBSERVE_TEMPORAL_UNIT_MINUTE

endif # menuconfig USE_FOLD

endmenu # Data preprocessing configuration
