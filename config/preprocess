menu "Data preprocessing"

config DROP_SUN_LIMB
	bool "Erase the solar limb from input images"
	default y

config DROP_CORRUPTED_ANNO
	bool "Drop corrupted annotations"
	default y

menuconfig DROP_CONFLICTED_ANNO
	bool "Drop conflicting annotations across annotators"
	default y

if DROP_CONFLICTED_ANNO
	config CONFLICT_COVERAGE_THRESHOLD
		int "Minimum coverage to consider conflicting in precent"
		range 0 100
		default 55

	config CONFLICT_WINNER_LENGTH_RATIO
		int "Target winner-to-longest filament length ratio in percent"
		range 0 100
		default 100
endif # menuconfig DROP_CONFLICTED_ANNO

menuconfig DROP_OVERLAPPED_ANNO
	bool "Drop annotations with overlapping polygons"
	default y

if DROP_OVERLAPPED_ANNO
	config OVERLAP_DROP_THRESHOLD
		int "Minimum IoU for dropping overlapping annotations in percent"
		range 0 100
		default 5
endif # menuconfig DROP_OVERLAPPED_ANNO

endmenu # Data preprocessing configuration
