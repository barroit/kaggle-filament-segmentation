menu "Training"

config FOLD_SPLIT_SEED
	int "Fold splitting shuffle seed"
	default 39

choice
	prompt "Fold splitting granularity"
	default FOLD_SPLIT_BY_DATE

config FOLD_SPLIT_BY_DATE
	bool "Split by date"

config FOLD_SPLIT_BY_HOUR
	bool "Split by hour"

config FOLD_SPLIT_BY_MINUTE
	bool "Split by minute"

endchoice

config FOLD_SPLIT_GRANULARITY
	int
	default 8 if FOLD_SPLIT_BY_DATE
	default 10 if FOLD_SPLIT_BY_HOUR
	default 12 if FOLD_SPLIT_BY_MINUTE

config FOLD_VERIFY_RATIO
	int "Verification splitting ratio"
	default 2

endmenu # Training
